From 72d1238f3f9d852af1af4a56182f28ed4accc583 Mon Sep 17 00:00:00 2001
From: Vividh Yadav <vividh50@gmail.com>
Date: Fri, 20 Nov 2026 20:57:28 +0000
Subject: [PATCH] Keep exact-duplicate vectors reachable in HNSW

A group of identical vectors larger than the level-0 list (2M) filled each
copy's list with other copies only, since duplicates tie at their distance
to the point and all pass the neighbor pruning. Reverse links from later
points then lost to the tied copies, so a search reaching the group could
not leave it and returned fewer than k results, and copies whose reverse
links all lost were unreachable.

A point with an exact duplicate among its level-0 link targets now takes
nb_neighbors(1) links, as the HNSW paper does at every level, leaving the
rest of its list free for other points' links. Points without exact
duplicates are linked as before: on GloVe-100 and SIFT (200k vectors each)
the graph is byte-identical, and SIFT1M recall@10 is unchanged at
efSearch >= 64.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017uaXZrSYSh1iMaFrDMbm4o
---
 faiss/impl/HNSW.cpp       | 40 +++++++++++++++++++++++++++++++++++++--
 tests/test_graph_based.py | 36 +++++++++++++++++++++++++++++++++++
 2 files changed, 74 insertions(+), 2 deletions(-)

diff --git a/faiss/impl/HNSW.cpp b/faiss/impl/HNSW.cpp
index d3b5465..42548cd 100644
--- a/faiss/impl/HNSW.cpp
+++ b/faiss/impl/HNSW.cpp
@@ -7,6 +7,7 @@
 
 #include <faiss/impl/HNSW.h>
 
+#include <algorithm>
 #include <array>
 #include <cinttypes>
 #include <cstddef>
@@ -586,6 +587,41 @@ void search_neighbors_to_add_dispatch(
     call(vts);
 }
 
+/// Number of neighbors a point being added links to at `level`.
+///
+/// The full list size is used, except for a point with an exact duplicate among
+/// its link targets at level 0. Duplicates tie at their distance to the point,
+/// so they all pass the pruning in shrink_neighbor_list and would fill the
+/// point's whole 2M level-0 list with copies. Once a group of duplicates
+/// outgrows the list, copies then link only to one another: later points'
+/// reverse links lose to the tied copies, a search that reaches the group
+/// cannot leave it, and copies whose reverse links all lose become unreachable.
+/// Such a point takes nb_neighbors(1) links, as the HNSW paper does at every
+/// level (Algorithm 1), and the rest of its list stays free for links from
+/// other points. Points without exact duplicates are linked exactly as before.
+template <class C>
+int nb_links_to_add(
+        const HNSW& hnsw,
+        DistanceComputer& ptdis,
+        storage_idx_t pt_id,
+        const std::priority_queue<HNSW::NodeDistCloserT<C>>& link_targets,
+        int level) {
+    int M = hnsw.nb_neighbors(level);
+    if (level != 0 || hnsw.cum_nneighbor_per_level.size() < 3) {
+        return M;
+    }
+    const float d_self = ptdis.symmetric_dis(pt_id, pt_id);
+    // scanned on a copy, so the order of tied targets stays as it is
+    auto targets = link_targets;
+    while (!targets.empty()) {
+        if (targets.top().id != pt_id && targets.top().d == d_self) {
+            return std::min(M, hnsw.nb_neighbors(1));
+        }
+        targets.pop();
+    }
+    return M;
+}
+
 /// Templated implementation of `HNSW::add_links_starting_from`.
 template <class C>
 void add_links_starting_from_impl(
@@ -604,7 +640,7 @@ void add_links_starting_from_impl(
             hnsw, ptdis, link_targets, nearest, d_nearest, level, vt, false);
 
     // but we can afford only this many neighbors
-    int M = hnsw.nb_neighbors(level);
+    int M = nb_links_to_add<C>(hnsw, ptdis, pt_id, link_targets, level);
 
     shrink_neighbor_list_inner<C>(ptdis, link_targets, M, keep_max_size_level0);
 
@@ -829,7 +865,7 @@ void compute_forward_links_impl(
                 vt,
                 false);
 
-        int M = hnsw.nb_neighbors(level);
+        int M = nb_links_to_add<C>(hnsw, ptdis, pt_id, link_targets, level);
         shrink_neighbor_list_inner<C>(
                 ptdis, link_targets, M, keep_max_size_level0 && (level == 0));
 
diff --git a/tests/test_graph_based.py b/tests/test_graph_based.py
index 452f64a..8156653 100644
--- a/tests/test_graph_based.py
+++ b/tests/test_graph_based.py
@@ -364,6 +364,42 @@ class TestHNSWNaN(unittest.TestCase):
         self.assertEqual(index.ntotal, nb + 1)
 
 
+class TestHNSWDuplicates(unittest.TestCase):
+    """A group of identical vectors larger than the level-0 list (2M) used to
+    fill each copy's list with other copies only: some copies became
+    unreachable, and a search reaching the group could not leave it."""
+
+    def check(self, metric, M):
+        rs = np.random.RandomState(0)
+        d, n_copies, n_others = 16, 200, 800
+        base = rs.randn(d).astype("float32")
+        others = rs.randn(n_others, d).astype("float32")
+        if metric == faiss.METRIC_INNER_PRODUCT:
+            base /= np.linalg.norm(base)
+            others /= np.linalg.norm(others, axis=1, keepdims=True)
+        xb = np.vstack([np.tile(base, (n_copies, 1)), others])
+
+        index = faiss.IndexHNSWFlat(d, M, metric)
+        index.hnsw.efConstruction = 100
+        index.add(xb)
+        params = faiss.SearchParametersHNSW(efSearch=1000)
+
+        # every copy is found by a search for the duplicated vector
+        _, I = index.search(base[None], n_copies, params=params)
+        self.assertEqual(set(I[0].tolist()), set(range(n_copies)))
+
+        # a search starting among the copies still returns k results
+        _, I = index.search(base[None], 300, params=params)
+        self.assertEqual(int((I[0] >= 0).sum()), 300)
+
+    def test_duplicates_l2(self):
+        for M in 16, 32:
+            self.check(faiss.METRIC_L2, M)
+
+    def test_duplicates_ip(self):
+        self.check(faiss.METRIC_INNER_PRODUCT, 16)
+
+
 class Issue3684(unittest.TestCase):
 
     def test_issue3684(self):
