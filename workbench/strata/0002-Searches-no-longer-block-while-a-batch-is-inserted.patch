+  std::vector<std::string> md2(extra, R"({"part": "new"})");
+  col->upsert(ids.data() + base, vecs.data() + base * cfg.dim, extra, md2);
+  writing.store(false);
+  reader.join();
+  CHECK(answered.load() > 0);
+  CHECK(bad.load() == 0);
+  CHECK(col->size() == base + extra);
+}
